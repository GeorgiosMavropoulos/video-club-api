				{
					"listen": "test",
					"script": {
						"exec": [
							"//validating that status code is 200!",
							"pm.test(\"status code is 200 or 204\", function () {",
							"    pm.expect(pm.response.code).to.have.be.oneOf([200,404]);",
							"});",
							"",
							"//checking if resonse is in json format!",
							"pm.test(\"response is in json format\", function () {",
							"    pm.response.to.be.json;",
							"});",
							"",
							"//validating that respone will be a success message and id will be an existed one!",
							"pm.test('Response contains a success message or a failure message',function(){",
							"    const json = pm.response.json();",
							"    const id = pm.request.url.path[1]",
							"    if(pm.response.code ===200)",
							"    {",
							"       pm.expect(json.message).to.eql(`Movie with id:${id} has been deleted!`);",
							"    }",
							"    else if(pm.response.code === 404)",
							"    {",
							"     pm.expect(json.message).to.eql(`Movie with id:${id} does not exists`);",
							"    }",
							"    ",
							"});"
						],
						"type": "text/javascript",
